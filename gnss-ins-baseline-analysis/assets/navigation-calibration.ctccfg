> START_CTCCFG
# Normalized CTCLib calibration template.
# Replace every angle-bracket placeholder before running.
[ctclib]
gimode = 1
rtcm_time = <YYYY-MM-DD>
file_input_obs_rover = <ABSOLUTE_INPUT_PATH>
selfoutput = 0
dir_output = <ABSOLUTE_OUTPUT_DIR>
realtime_mode = 0

[ctclib_core]
device_name = <DEVICE_NAME>

[ctclib_ins]
ins_mode = 1
carrier = <CARRIER_ENUM>
imu_freq = <IMU_FREQUENCY_HZ>
navsol_gnss_freq = <GNSS_NAV_FREQUENCY_HZ>
b_2ant_available = <DUAL_ANTENNA_AVAILABLE_0_OR_1>
log_level = 5, -1

method_dr = 2
method_align_velyaw = 0
method_align_velyaw_min = 0
method_adaptive_calib = 1
method_use_navsol = 0
method_vio_yaw = <VIO_YAW_ENABLED_0_OR_1>

gyo_arw = <GYRO_ARW_X_Y_Z>
acc_vrw = <ACC_VRW_X_Y_Z>

lever_imu2gnss = <INITIAL_IMU_TO_GNSS_M>
lever_imu2car = <INITIAL_IMU_TO_CAR_M>
install_imu2car = <INITIAL_IMU_TO_CAR_DEG>
install_gnss2car = <INITIAL_GNSS_TO_CAR_DEG>
lever_imu2vio = <INITIAL_IMU_TO_VIO_M>
install_car2vio = <INITIAL_CAR_TO_VIO_DEG>

est_lever_imu2gnss = <ENABLE_IMU_GNSS_LEVER_0_OR_1>
est_lever_imu2car = <ENABLE_IMU_CAR_LEVER_0_OR_1>
est_install_imu2car = <ENABLE_IMU_CAR_INSTALL_0_OR_1>
est_install_gnss2car = <ENABLE_GNSS_CAR_INSTALL_0_OR_1>
est_lever_imu2vio = <ENABLE_IMU_VIO_LEVER_0_OR_1>
est_install_car2vio = <ENABLE_CAR_VIO_INSTALL_0_OR_1>

lever_imu2gnss_std = <INITIAL_IMU_GNSS_LEVER_STD_M>
lever_imu2car_std = <INITIAL_IMU_CAR_LEVER_STD_M>
install_imu2car_std = <INITIAL_IMU_CAR_INSTALL_STD_DEG>
install_gnss2car_std = <INITIAL_GNSS_CAR_INSTALL_STD_DEG>
lever_imu2vio_std = <INITIAL_IMU_VIO_LEVER_STD_M>
install_car2vio_std = <INITIAL_CAR_VIO_INSTALL_STD_DEG>
> END_CTCCFG
